{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "legal-liminghua-fyi",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "legal.liminghua.fyi",
      "custom_domain": true
    }
  ]
}
